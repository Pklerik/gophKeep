# GophKeeper Docker environment variables
# Copy to .env and customize for your environment

# Server configuration
SERVER_ADDRESS=0.0.0.0:8080
SECRET_KEY=your-secret-key-here-change-in-production
LOG_LEVEL=info

# PostgreSQL configuration
POSTGRES_USER=gophkeeper
POSTGRES_PASSWORD=gophkeeper_password
POSTGRES_DB=gophkeeper

# Database connection (formed automatically in docker-compose)
# DATABASE_URL=postgres://gophkeeper:gophkeeper_password@postgres:5432/gophkeeper?sslmode=disable
