    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch file",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "asRoot": true,
        },
        {
            "name": "server",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "/Users/pavelbudkov/dev/gophKeep/cmd/gophkeep",
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "asRoot": true,
            "args": [
                "server",
                "--a",
                ":8080",
                "-l",
                "DEBUG",
                "-t",
                "10s",
            ],
            "env": {
                "DATABASE_URL": "postgres://gophkeeper:gophkeeper_password@localhost:5432/gophkeeper?sslmode=disable",
                "GOOSE_DRIVER": "postgres",
                "GOOSE_DBSTRING": "postgres://gophkeeper:gophkeeper_password@localhost:5432/gophkeeper?sslmode=disable",
                "GOOSE_MIGRATION_DIR": "/Users/pavelbudkov/dev/gophKeep/migrations",
                "SECRET_KEY": "secret_key",
            },
        },
        {
            "name": "client",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "/Users/pavelbudkov/dev/gophKeep/cmd/gophkeep",
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "asRoot": true,
            "args": [
                "client",
                "-l",
                "DEBUG",
            ],
            "envFile": "${workspaceFolder}/.env"
        },
    ]
}